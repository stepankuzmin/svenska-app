{
  "name": "svenska-app",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/sync/*"
    ]
  },
  "main": "worker/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "LIBRARIES",
        "class_name": "LookupLibrary"
      }
    ]
  },
  "migrations": [
    {
      "tag": "lookup-library-v1",
      "new_sqlite_classes": [
        "LookupLibrary"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "SYNC_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
