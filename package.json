{
  "name": "svenska-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run dictionary:build && tsc -b && vite build",
    "dev": "npm run dictionary:build && vite",
    "dictionary:build": "tsx scripts/build-dictionary.ts",
    "test:browser": "npm run build && playwright test",
    "test:browser:release": "playwright test",
    "release:check": "tsx scripts/validate-dictionary-release.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run dictionary:build && tsc -b --pretty false",
    "lint": "oxlint --deny-warnings",
    "check:floor": "tsx scripts/constraints/floor-guard.ts",
    "check:coverage": "vitest run --coverage && tsx scripts/constraints/changed-coverage.ts",
    "check:size": "size-limit",
    "check:fast": "npm run typecheck && npm run lint && npm run check:floor",
    "check:task": "npm run check:fast && npm run check:coverage && npm run build && npm run check:size",
    "check:full": "npm run check:task && npm run release:check && npm run test:browser:release"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "fast-xml-parser": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.0.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^5.0.2",
    "oxlint": "^1.85.0",
    "size-limit": "^14.0.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "latest"
  }
}
