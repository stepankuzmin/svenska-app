{
  "name": "svenska-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run dictionary:build && npm run worker:types && tsc -b && cf build",
    "dev": "npm run dictionary:build && vite",
    "dictionary:build": "tsx scripts/build-dictionary.ts",
    "test:browser": "npm run build && playwright test",
    "test:browser:release": "playwright test",
    "release:check": "tsx scripts/validate-dictionary-release.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run dictionary:build && npm run worker:types && tsc -b --pretty false",
    "lint": "oxlint --deny-warnings",
    "check:floor": "tsx scripts/constraints/floor-guard.ts",
    "check:complexity": "sh scripts/cccc.sh .",
    "check:coverage": "vitest run --coverage && tsx scripts/constraints/changed-coverage.ts",
    "check:size": "size-limit",
    "check:fast": "npm run typecheck && npm run lint && npm run check:floor",
    "check:task": "npm run check:fast && npm run check:coverage && npm run build && npm run check:size",
    "check:full": "npm run check:task && npm run release:check && npm run test:browser:release",
    "worker:types": "cf workers types",
    "worker:dev": "cf build --mode test && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "worker:check": "cf deploy --prebuilt --dry-run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@vitejs/plugin-react": "latest",
    "fast-xml-parser": "latest",
    "idb": "^8.0.4",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest",
    "@tanstack/query-core": "^5.104.2"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "^0.9.4",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "@e18e/eslint-plugin": "^0.8.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^5.0.5",
    "cf": "^1.0.0-beta.21",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.88.0",
    "size-limit": "^14.0.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "latest",
    "wrangler": "^4.149.0"
  }
}
