[
  {
    "name": "App JS",
    "path": [
      ".cloudflare/output/v0/workers/default/assets/assets/index-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/words-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/jsx-runtime-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/dictionary-search-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/session-bridge-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/store-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/model-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/load-transport-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/sync-control-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/status-*.js",
      ".cloudflare/output/v0/workers/default/assets/assets/word-card-details-*.js"
    ],
    "limit": "100 kB"
  },
  {
    "name": "App CSS",
    "path": ".cloudflare/output/v0/workers/default/assets/assets/index-*.css",
    "limit": "2.50 kB"
  },
  {
    "name": "Dictionary release: lookup file",
    "path": ".cloudflare/output/v0/workers/default/assets/lexin-dictionary.*.json"
  },
  {
    "name": "Dictionary release: word-detail file",
    "path": ".cloudflare/output/v0/workers/default/assets/lexin-details.*.json"
  },
  {
    "name": "HTML",
    "path": ".cloudflare/output/v0/workers/default/assets/index.html",
    "limit": "0.45 kB"
  },
  {
    "name": "Web manifest",
    "path": ".cloudflare/output/v0/workers/default/assets/manifest.webmanifest"
  },
  {
    "name": "Service worker",
    "path": ".cloudflare/output/v0/workers/default/assets/sw.js"
  },
  {
    "name": "Workbox runtime",
    "path": ".cloudflare/output/v0/workers/default/assets/workbox-*.js"
  }
]
